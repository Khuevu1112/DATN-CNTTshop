SELECT 
    COUNT(*) AS TongSanPham
FROM PRODUCT;
SELECT
    p.id,
    p.name,
    SUM(CASE WHEN pi.is_primary = 1 THEN 1 ELSE 0 END) AS AnhChinh,
    SUM(CASE WHEN pi.is_primary = 0 THEN 1 ELSE 0 END) AS AnhPhu,
    COUNT(pi.id) AS TongAnh
FROM PRODUCT p
LEFT JOIN PRODUCT_IMAGE pi
    ON pi.product_id = p.id
GROUP BY
    p.id,
    p.name
ORDER BY p.id;

---Thêm số lượng sản phẩm có biến--- 
SELECT
    p.id,
    p.name,
    SUM(pv.stock) AS SoLuongTon
FROM PRODUCT p
LEFT JOIN PRODUCT_VARIANT pv
    ON pv.product_id = p.id
GROUP BY
    p.id,
    p.name
ORDER BY
    p.id;

