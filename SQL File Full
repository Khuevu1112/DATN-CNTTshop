---Xem Số, Xóa Ảnh (Không nhất thiết phải chạy trừ việc muốn xem hoặc xóa dữ liệu)---
SELECT
    product_id,
    COUNT(*) AS SoAnh,
    SUM(CASE WHEN is_primary = 1 THEN 1 ELSE 0 END) AS AnhChinh,
    SUM(CASE WHEN is_primary = 0 THEN 1 ELSE 0 END) AS AnhPhu
FROM PRODUCT_IMAGE
GROUP BY product_id
ORDER BY product_id;

SELECT
    id,
    product_id,
    url,
    is_primary,
    sort_order
FROM PRODUCT_IMAGE
WHERE product_id = 881
ORDER BY sort_order;

SELECT
    product_id,
    url,
    COUNT(*) AS SoLan
FROM PRODUCT_IMAGE
GROUP BY product_id, url
HAVING COUNT(*) > 1
ORDER BY product_id;

SELECT SUM(SoLan - 1) AS SoAnhBiTrung
FROM (
    SELECT
        product_id,
        url,
        COUNT(*) AS SoLan
    FROM PRODUCT_IMAGE
    GROUP BY product_id, url
    HAVING COUNT(*) > 1
) x;

WITH DuplicateImages AS
(
    SELECT
        id,
        ROW_NUMBER() OVER (
            PARTITION BY product_id, url
            ORDER BY id
        ) AS rn
    FROM PRODUCT_IMAGE
)
DELETE FROM PRODUCT_IMAGE
WHERE id IN
(
    SELECT id
    FROM DuplicateImages
    WHERE rn > 1
);

SELECT 
    p.id,
    p.name,
    COUNT(pi.id) AS SoAnh
FROM PRODUCT p
LEFT JOIN PRODUCT_IMAGE pi 
    ON pi.product_id = p.id
GROUP BY p.id, p.name
HAVING COUNT(pi.id) > 4
ORDER BY SoAnh DESC;

