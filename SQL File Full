---Thêm ảnh phụ---
SET NOCOUNT ON;
SET XACT_ABORT ON;

BEGIN TRY

    BEGIN TRANSACTION;


    /* =========================================================
       BƯỚC 1
       TẠO ẢNH CHÍNH CHO NHỮNG PRODUCT CHƯA CÓ ẢNH CHÍNH
       ========================================================= */

    INSERT INTO PRODUCT_IMAGE
    (
        product_id,
        variant_id,
        url,
        is_primary,
        sort_order
    )
    SELECT
        p.id,
        NULL,
        'https://placehold.co/800x800?text=Product+'
            + CAST(p.id AS VARCHAR(20)),
        1,
        0
    FROM PRODUCT p
    WHERE NOT EXISTS
    (
        SELECT 1
        FROM PRODUCT_IMAGE pi
        WHERE pi.product_id = p.id
          AND pi.is_primary = 1
    );


    /* =========================================================
       BƯỚC 2
       THÊM 3 ẢNH PHỤ CHO MỖI PRODUCT

       1 = ảnh phụ 1
       2 = ảnh phụ 2
       3 = ảnh phụ 3
       ========================================================= */

    ;WITH Numbers AS
    (
        SELECT 1 AS n
        UNION ALL
        SELECT 2
        UNION ALL
        SELECT 3
    ),

    ExistingSecondary AS
    (
        SELECT
            p.id AS product_id,
            COUNT(pi.id) AS secondary_count
        FROM PRODUCT p
        LEFT JOIN PRODUCT_IMAGE pi
            ON pi.product_id = p.id
           AND pi.is_primary = 0
        GROUP BY p.id
    ),

    Missing AS
    (
        SELECT
            e.product_id,
            n.n
        FROM ExistingSecondary e
        CROSS JOIN Numbers n
        WHERE n.n > e.secondary_count
    )

    INSERT INTO PRODUCT_IMAGE
    (
        product_id,
        variant_id,
        url,
        is_primary,
        sort_order
    )
    SELECT
        m.product_id,
        NULL,

        'https://placehold.co/800x800?text=Product+'
        + CAST(m.product_id AS VARCHAR(20))
        + '+Image+'
        + CAST(m.n AS VARCHAR(10)),

        0,

        m.n

    FROM Missing m
    WHERE NOT EXISTS
    (
        SELECT 1
        FROM PRODUCT_IMAGE pi
        WHERE pi.product_id = m.product_id
          AND pi.is_primary = 0
          AND pi.sort_order = m.n
    );


    /* =========================================================
       BƯỚC 3
       COMMIT
       ========================================================= */

    COMMIT TRANSACTION;


    PRINT '===============================================';
    PRINT 'THANH CONG!';
    PRINT 'DA KIEM TRA TOAN BO SAN PHAM TRONG PRODUCT.';
    PRINT 'MOI SAN PHAM CO ANH CHINH + TOI DA 3 ANH PHU.';
    PRINT '===============================================';


END TRY

BEGIN CATCH

    IF @@TRANCOUNT > 0
        ROLLBACK TRANSACTION;

    PRINT '===============================================';
    PRINT 'CO LOI! DU LIEU DA DUOC ROLLBACK.';
    PRINT '===============================================';

    THROW;

END CATCH;
